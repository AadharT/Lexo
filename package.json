{
  "name": "lexo",
  "version": "0.5.0",
  "private": true,
  "description": "Local case and document management for Indian legal practices",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package": "vite build && electron-builder --win portable"
  },
  "dependencies": {
    "docx": "^9.0.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.3.1",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "in.lexo.desktop",
    "productName": "Lexo",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/**/*.cjs",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/fflate/**/*",
      "node_modules/sax/**/*",
      "node_modules/@napi-rs/**/*",
      "electron/directory-cache.cjs"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/lexo.ico",
      "signExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "Lexo-${version}-win-x64.${ext}"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
